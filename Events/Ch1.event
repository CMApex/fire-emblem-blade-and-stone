// ============================================================
//  Blade & Stone — Chapter 1: The Marquess's Docks
//  Map: Ostia harbor district (21x21, port tileset obj 0E / pal 72 / cfg 10)
// ============================================================

#define BS_CH1 0x01

PUSH
  ORG ChapterDataTable + (BS_CH1 * ChapterDataTableEntSize) + 4
    BYTE 0x0E 0x00 0x72 0x10 0x08 0x00 0x00 0x09   // obj1 obj2 pal config mapID anim1 anim2 mapchanges
  ORG ChapterDataTable + (BS_CH1 * ChapterDataTableEntSize) + 12
    BYTE 0x00                                      // no fog
  ORG ChapterDataTable + (BS_CH1 * ChapterDataTableEntSize) + 22
    SHORT 0x0A      // player phase: Rise Above
    SHORT 0x14      // enemy phase: Assault
  ORG ChapterDataTable + (BS_CH1 * ChapterDataTableEntSize) + 112
    SHORT BS_Ch1Name BS_Ch1Name
  ORG ChapterDataTable + (BS_CH1 * ChapterDataTableEntSize) + 136
    SHORT BS_Ch1Goal BS_Ch1Goal
POP

ALIGN 4
BS_Ch1Map:
  #incbin "../Maps/bs_ch1_data.dmp"
EventPointerTable(0x08, BS_Ch1Map)

ALIGN 4
BS_C1_MapChanges:
  TileMapEnd
EventPointerTable(0x09, BS_C1_MapChanges)

EventPointerTable(0x0A, BS_C1_PointerList)

ALIGN 4
BS_C1_PointerList:
POIN BS_C1_Turn BS_C1_TalkList BS_C1_Location BS_C1_Misc
POIN BS_C1_Dunno BS_C1_Dunno BS_C1_Dunno BS_C1_Dunno
POIN BS_C1_Traps BS_C1_Traps
POIN BS_C1_Party BS_C1_Party
POIN 0 0 0
POIN 0 0 0
POIN BS_C1_Beginning BS_C1_EndScene

BS_C1_Turn:
  TurnEventPlayer(0, BS_C1_Turn2Warn, 2)
  TurnEventPlayer(0, BS_C1_EliwoodArrives, 2)
  TurnEventEnemy(0, BS_C1_Reinforce, 3)
  TurnEventEnemy(0, BS_C1_Reinforce, 5)
  TurnEventEnemy(0, BS_C1_Reinforce, 7)
  END_MAIN

BS_C1_TalkList:
  CharacterEventBothWays(0x12, BS_C1_TalkEvent, 0x2E, 0x2D)
  END_MAIN

BS_C1_Location:
  House(0x10, BS_C1_HouseWEvent, 3, 3)
  House(0x11, BS_C1_HouseEEvent, 17, 3)
  END_MAIN

BS_C1_Misc:
  DefeatBoss(BS_C1_EndScene)
  CauseGameOverIfLordDies
  END_MAIN

BS_C1_Dunno:
  END_MAIN

BS_C1_Traps:
  ENDTRAP
  ALIGN 4

// ---------- units ----------
#define BS_Hector 0x2E
#define BS_Eliwood 0x2D
#define BS_Oswin 0x2F
#define BS_Matthew 0x30
#define BS_Serra 0x31
#define BS_Husk 0x58
#define BS_HollowCaptain 0x59
#ifndef IronBow
  #define IronBow 0x2D
#endif
#ifndef SteelAxe
  #define SteelAxe 0x20
#endif
#ifndef Mend
  #define Mend 0x4C
#endif
#ifndef Lightning
  #define Lightning 0x3E
#endif

BS_C1_Party:
#ifdef BS_DEBUG_CH1
UNIT BS_Hector  0x78 0x00 Level(1, Ally, False) [6,18] 0b 0x0 0x0 0x0 [SteelAxe, HandAxe, Vulnerary, 0] NoAI
#else
UNIT BS_Hector  0x78 0x00 Level(1, Ally, False) [10,1] 0b 0x0 0x0 0x0 [SteelAxe, HandAxe, Vulnerary, 0] NoAI
#endif
UNIT BS_Oswin   0x0B 0x00 Level(5, Ally, False) [11,0] 0b 0x0 0x0 0x0 [SteelLance, Javelin, 0, 0] NoAI
UNIT BS_Matthew 0x33 0x00 Level(1, Ally, False) [9,1]  0b 0x0 0x0 0x0 [SteelSword, Vulnerary, 0, 0] NoAI
UNIT BS_Serra   0x2C 0x00 Level(1, Ally, False) [10,0] 0b 0x0 0x0 0x0 [Mend, Lightning, 0, 0] NoAI
UNIT

BS_C1_EliwoodUnit:
UNIT BS_Eliwood 0x77 0x00 Level(1, Ally, False) [20,4] 0b 0x0 0x0 0x0 [SteelSword, Javelin, Vulnerary, 0] NoAI
UNIT

BS_C1_Enemies:
#ifdef BS_DEBUG_CH1
UNIT BS_HollowCaptain 0x43 0x00 Level(1, Enemy, False) [6,19] 0b 0x0 0x0 0x0 [HandAxe, 0, 0, 0] NeverMoveAI
#else
UNIT BS_HollowCaptain 0x43 0x00 Level(5, Enemy, True) [6,19] 0b 0x0 0x0 0x0 [SteelAxe, HandAxe, 0, 0] NeverMoveAI
#endif
UNIT BS_Husk 0x0F 0x00 Level(5, Enemy, True) [7,17]  0b 0x0 0x0 0x0 [IronSword, 0, 0, 0] AttackInRangeAI
UNIT BS_Husk 0x3F 0x00 Level(4, Enemy, True) [6,9]   0b 0x0 0x0 0x0 [IronAxe, 0, 0, 0] DefaultAI
UNIT BS_Husk 0x4E 0x00 Level(4, Enemy, True) [13,9]  0b 0x0 0x0 0x0 [IronLance, 0, 0, 0] DefaultAI
UNIT BS_Husk 0x0F 0x00 Level(4, Enemy, True) [3,10]  0b 0x0 0x0 0x0 [IronSword, 0, 0, 0] DefaultAI
UNIT BS_Husk 0x19 0x00 Level(4, Enemy, True) [16,10] 0b 0x0 0x0 0x0 [IronBow, 0, 0, 0] DefaultAI
UNIT BS_Husk 0x3F 0x00 Level(5, Enemy, True) [9,12]  0b 0x0 0x0 0x0 [HandAxe, 0, 0, 0] DefaultAI
UNIT BS_Husk 0x4E 0x00 Level(5, Enemy, True) [1,12]  0b 0x0 0x0 0x0 [IronLance, 0, 0, 0] DefaultAI
UNIT BS_Husk 0x42 0x00 Level(5, Enemy, True) [13,15] 0b 0x0 0x0 0x0 [IronAxe, 0, 0, 0] AttackInRangeAI
UNIT BS_Husk 0x42 0x00 Level(5, Enemy, True) [0,16]  0b 0x0 0x0 0x0 [IronAxe, 0, 0, 0] AttackInRangeAI
UNIT BS_Husk 0x19 0x00 Level(5, Enemy, True) [13,19] 0b 0x0 0x0 0x0 [IronBow, 0, 0, 0] AttackInRangeAI
UNIT

BS_C1_ReinfUnits:
UNIT BS_Husk 0x42 0x00 Level(5, Enemy, True) [19,19] 0b 0x0 0x0 0x0 [IronAxe, 0, 0, 0] DefaultAI
UNIT BS_Husk 0x3F 0x00 Level(5, Enemy, True) [20,19] 0b 0x0 0x0 0x0 [HandAxe, 0, 0, 0] DefaultAI
UNIT

// ---------- scenes ----------
BS_C1_Beginning:
  SetBackground(0x0E)       // throne room
  MUSC 0x2A                 // Laughter
  TEXTSHOW BS_C1_Opening
  TEXTEND
  FADI 16
  REMA
  LOAD1 0x1 BS_C1_Party
  ENUN
  LOAD1 0x1 BS_C1_Enemies
  ENUN
  CAM1 [10,1]
  FADU 16
  STAL 20
  CAM1 [9,13]
  STAL 40
  CAM1 [10,1]
  MUSC 0x13
  Text(BS_C1_MapOpen)
  NoFade
  ENDA

BS_C1_Turn2Warn:
  CUMO [19,19]
  STAL 40
  CURE
  Text(BS_C1_Turn2)
  NoFade
  ENDA

BS_C1_Reinforce:
  CAM1 [19,18]
  LOAD1 0x1 BS_C1_ReinfUnits
  ENUN
  NoFade
  ENDA

BS_C1_EliwoodArrives:
  CAM1 [19,4]
  LOAD1 0x1 BS_C1_EliwoodUnit
  ENUN
  MUSC 0x07                 // Ties of Friendship
  Text(BS_C1_Eliwood)
  NoFade
  ENDA

BS_C1_TalkEvent:
  Text(BS_C1_Talk)
  NoFade
  ENDA

BS_C1_HouseWEvent:
  VillageEventItem(BS_C1_HouseW, 0x07, Elixir)

BS_C1_HouseEEvent:
  VillageEventItem(BS_C1_HouseE, 0x24, PureWater)

BS_C1_EndScene:
  MUSC 0x2F
  Text(BS_C1_Ending)
  SetBackground(0x07)
  TEXTSHOW BS_C1_End
  TEXTEND
  FADI 16
  REMA
  EVBIT_F 0x2
  MNTS 0x1
  NoFade
  ENDA
