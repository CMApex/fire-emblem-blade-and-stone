// ============================================================
//  Blade & Stone — Chapter 1: The Marquess's Docks
//  Map: Ostia harbor district (21x23, port tileset obj 0E / pal 72 / cfg 10) — maps_src/ch1.sketch
//
//  Intent: three bands. The manor terrace (start) opens on market lanes; two walls with
//  narrow stair gaps cut the town from the quay — Hector and Oswin can plug a gap while
//  Matthew runs the western alley. The ghost ship's captain holds its deck; the second
//  ship's hold keeps emptying onto the east pier (telegraphed, turns 3 and 6).
// ============================================================

#define BS_CH1 0x01

PUSH
  ORG ChapterDataTable + (BS_CH1 * ChapterDataTableEntSize) + 4
    BYTE 0x0E 0x00 0x72 0x10 0x08 0x00 0x00 0x09   // obj1 obj2 pal config mapID anim1 anim2 mapchanges
  ORG ChapterDataTable + (BS_CH1 * ChapterDataTableEntSize) + 12
    BYTE 0x00                                      // no fog
  ORG ChapterDataTable + (BS_CH1 * ChapterDataTableEntSize) + 22
    SHORT 0x0A      // player phase: Rise Above
    SHORT 0x14      // enemy phase: Assault
  ORG ChapterDataTable + (BS_CH1 * ChapterDataTableEntSize) + 112
    SHORT BS_Ch1Name BS_Ch1Name
  ORG ChapterDataTable + (BS_CH1 * ChapterDataTableEntSize) + 136
    SHORT BS_Ch1Goal BS_Ch1Goal
POP

ALIGN 4
BS_Ch1Map:
  #incbin "../gen/maps/bs_ch1.dmp"
EventPointerTable(0x08, BS_Ch1Map)

ALIGN 4
BS_C1_MapChanges:
  TileMapEnd
EventPointerTable(0x09, BS_C1_MapChanges)

EventPointerTable(0x0A, BS_C1_PointerList)

ALIGN 4
BS_C1_PointerList:
POIN BS_C1_Turn BS_C1_TalkList BS_C1_Location BS_C1_Misc
POIN BS_C1_Dunno BS_C1_Dunno BS_C1_Dunno BS_C1_Dunno
POIN BS_C1_Traps BS_C1_Traps
POIN BS_C1_Party BS_C1_Party
POIN 0 0 0
POIN 0 0 0
POIN BS_C1_Beginning BS_C1_EndScene

BS_C1_Turn:
  TurnEventPlayer(0, BS_C1_Turn2Warn, 2)
  TurnEventPlayer(0, BS_C1_EliwoodArrives, 2)
  TurnEventEnemy(0, BS_C1_Reinforce, 3)
  TurnEventEnemy(0, BS_C1_Reinforce, 6)
  END_MAIN

BS_C1_TalkList:
  CharacterEventBothWays(0x12, BS_C1_TalkEvent, BS_PID_HECTOR, BS_PID_ELIWOOD)
  END_MAIN

BS_C1_Location:
  House(0x10, BS_C1_HouseWEvent, 8, 2)
  House(0x11, BS_C1_HouseEEvent, 15, 6)
  Vendor(BS_C1_Shop, 9, 6)
  END_MAIN

BS_C1_Misc:
  DefeatBoss(BS_C1_EndScene)
  CauseGameOverIfLordDies
  END_MAIN

BS_C1_Dunno:
  END_MAIN

BS_C1_Traps:
  ENDTRAP
  ALIGN 4

ALIGN 4
BS_C1_Shop:
  SHORT Vulnerary Elixir PureWater Javelin HandAxe 0

// ---------- units ----------
#define BS_Husk BS_PID_HUSK
#define BS_HollowCaptain BS_PID_HOLLOWCAPTAIN

BS_C1_Party:
#ifdef BS_DEBUG_CH1
UNIT BS_PID_HECTOR BS_CLASS_HECTOR 0x00 Level(BS_LV_HECTOR, Ally, False) [7,20] 0b 0x0 0x0 0x0 [SteelAxe, HandAxe, Vulnerary, 0] NoAI
#else
UNIT BS_PID_HECTOR BS_CLASS_HECTOR 0x00 Level(BS_LV_HECTOR, Ally, False) [12,2] 0b 0x0 0x0 0x0 [SteelAxe, HandAxe, Vulnerary, 0] NoAI
#endif
UNIT BS_PID_OSWIN   BS_CLASS_OSWIN   0x00 Level(BS_LV_OSWIN, Ally, False)   [13,2] 0b 0x0 0x0 0x0 [SteelLance, Javelin, 0, 0] NoAI
UNIT BS_PID_MATTHEW BS_CLASS_MATTHEW 0x00 Level(BS_LV_MATTHEW, Ally, False) [12,3] 0b 0x0 0x0 0x0 [SteelSword, Vulnerary, 0, 0] NoAI
UNIT BS_PID_SERRA   BS_CLASS_SERRA   0x00 Level(BS_LV_SERRA, Ally, False)   [13,3] 0b 0x0 0x0 0x0 [Mend, Lightning, 0, 0] NoAI
UNIT

BS_C1_EliwoodUnit:
UNIT BS_PID_ELIWOOD BS_CLASS_ELIWOOD 0x00 Level(BS_LV_ELIWOOD, Ally, False) [20,4] 0b 0x0 0x0 0x0 [SteelSword, Javelin, Vulnerary, 0] NoAI
UNIT

// The Hollowed: drowned sailors and dockhands (generic "Husk", veteran-scale bases in data/npcs.csv).
BS_C1_Enemies:
#ifdef BS_DEBUG_CH1
UNIT BS_HollowCaptain 0x43 0x00 Level(1, Enemy, False) [6,20] 0b 0x0 0x0 0x0 [HandAxe, 0, 0, 0] NeverMoveAI
#else
UNIT BS_HollowCaptain 0x43 0x00 Level(8, Enemy, True) [6,20] 0b 0x0 0x0 0x0 [SteelAxe, HandAxe, 0, 0] NeverMoveAI
#endif
// the ghost ship's deck
UNIT BS_Husk 0x19 0x00 Level(12, Enemy, True) [7,19]  0b 0x0 0x0 0x0 [IronBow, 0, 0, 0] AttackInRangeAI      // Archer
UNIT BS_Husk 0x42 0x00 Level(12, Enemy, True) [5,21]  0b 0x0 0x0 0x0 [IronAxe, 0, 0, 0] AttackInRangeAI      // Pirate
// the piers
UNIT BS_Husk 0x40 0x00 Level(4, Enemy, True)  [13,17] 0b 0x0 0x0 0x0 [SteelAxe, 0, 0, 0] DefaultAI           // Warrior
UNIT BS_Husk 0x43 0x00 Level(3, Enemy, True)  [12,20] 0b 0x0 0x0 0x0 [IronAxe, 0, 0, 0] DefaultAI            // Berserker
// the quay
UNIT BS_Husk 0x25 0x00 Level(12, Enemy, True) [5,13]  0b 0x0 0x0 0x0 [Fire, 0, 0, 0] DefaultAI              // Mage: magic finds the lords' low resistance
UNIT BS_Husk 0x43 0x00 Level(3, Enemy, True)  [13,13] 0b 0x0 0x0 0x0 [HandAxe, 0, 0, 0] DefaultAI
UNIT BS_Husk 0x42 0x00 Level(12, Enemy, True) [19,13] 0b 0x0 0x0 0x0 [IronAxe, 0, 0, 0] DefaultAI
// the lower street
UNIT BS_Husk 0x3F 0x00 Level(12, Enemy, True) [3,10]  0b 0x0 0x0 0x0 [Hammer, 0, 0, 0] AttackInRangeAI            // Fighter with a hammer: Oswin's problem
UNIT BS_Husk 0x11 0x00 Level(3, Enemy, True)  [12,10] 0b 0x0 0x0 0x0 [SteelSword, 0, 0, 0] AttackInRangeAI        // Hero
UNIT BS_Husk 0x1B 0x00 Level(3, Enemy, True)  [17,10] 0b 0x0 0x0 0x0 [IronBow, 0, 0, 0] AttackInRangeAI     // Sniper at the east stairs
// the market lanes
UNIT BS_Husk 0x40 0x00 Level(3, Enemy, True)  [9,4]   0b 0x0 0x0 0x0 [SteelAxe, 0, 0, 0] DefaultAI
UNIT BS_Husk 0x42 0x00 Level(12, Enemy, True) [3,4]   0b 0x0 0x0 0x0 [IronAxe, 0, 0, 0] AttackInRangeAI            // in the west alley
UNIT BS_Husk 0x19 0x00 Level(12, Enemy, True) [16,4]  0b 0x0 0x0 0x0 [IronBow, 0, 0, 0] AttackInRangeAI     // Archer in the trees
UNIT

BS_C1_ReinfUnits:     // out of the second ship's hold
UNIT BS_Husk 0x42 0x00 Level(12, Enemy, True) [19,20] 0b 0x0 0x0 0x0 [IronAxe, 0, 0, 0] DefaultAI
UNIT BS_Husk 0x43 0x00 Level(3, Enemy, True)  [20,21] 0b 0x0 0x0 0x0 [HandAxe, 0, 0, 0] DefaultAI
UNIT
BS_C1_ReinfHard:
UNIT BS_Husk 0x40 0x00 Level(4, Enemy, True)  [19,22] 0b 0x0 0x0 0x0 [SteelAxe, 0, 0, 0] DefaultAI
UNIT

// ---------- scenes ----------
BS_C1_Beginning:
  MUSC 0x2A                 // Laughter
  Text(0x0E, BS_C1_Opening) // throne room
  LOAD1 0x1 BS_C1_Party
  ENUN
  LOAD1 0x1 BS_C1_Enemies
  ENUN
  CAM1 [12,2]
  STAL 20
  CAM1 [6,19]
  STAL 40
  CAM1 [12,2]
  MUSC 0x13
  Text(BS_C1_MapOpen)
  NoFade
  ENDA

BS_C1_Turn2Warn:
  CUMO [19,20]
  STAL 40
  CURE
  Text(BS_C1_Turn2)
  NoFade
  ENDA

BS_C1_Reinforce:
  CAM1 [19,20]
  LOAD1 0x1 BS_C1_ReinfUnits
  ENUN
  CHECK_HARD
  BEQ 0x1 0xC 0x0
  LOAD1 0x1 BS_C1_ReinfHard
  ENUN
  LABEL 0x1
  NoFade
  ENDA

BS_C1_EliwoodArrives:
  CAM1 [19,4]
  LOAD1 0x1 BS_C1_EliwoodUnit
  ENUN
  MUSC 0x07                 // Ties of Friendship
  Text(BS_C1_Eliwood)
  NoFade
  ENDA

BS_C1_TalkEvent:
  Text(BS_C1_Talk)
  NoFade
  ENDA

BS_C1_HouseWEvent:
  VillageEventItem(BS_C1_HouseW, 0x07, Elixir)

BS_C1_HouseEEvent:
  VillageEventItem(BS_C1_HouseE, 0x24, PureWater)

BS_C1_EndScene:
  BS_SettleMapSprites        // let the boss's death dissolve finish before any faces load (see BladeAndStone.event)
  MUSC 0x2F
  Text(BS_C1_Ending)
  SetBackground(0x07)
  TEXTSHOW BS_C1_End
  TEXTEND
  FADI 16
  REMA
  ASMC BS_ClearSuspendASMC|1   // no leftover 'Resume Chapter' after the demo ends
  EVBIT_F 0x2
  MNTS 0x1
  NoFade
  ENDA
