#define ChapterDataTable 0x8B0890
#define ChapterDataTableEntSize 148

// FE8 shares sprite tiles 0x380-0x3FF between the 4th dialogue face slot and moving/dying unit
// sprites (MUs). A scene that starts while a unit is still moving or dissolving (e.g. a boss-kill
// ending) corrupts the 4th face. Every scene that can follow a kill or a move starts with this.
#define BS_SettleMapSprites "STAL 8; ENUN; STAL 32"
