#include "gen/BuildConfig.event"

#define ChapterDataTable 0x8B0890
#define ChapterDataTableEntSize 148

// Let a dying unit finish dissolving and moving units stop before a scene starts.
// Note: this does NOT make a 4th portrait safe. FE8 shares sprite tiles 0x380-0x3FF between the
// 4th dialogue face slot and the acting unit's map sprite, which stays alive after a boss kill.
// tools/gentext.py therefore rejects any message showing 4 faces at once (see HACKING.md).
#define BS_SettleMapSprites "STAL 8; ENUN; STAL 32"
#include "gen/BsMsgs.event"          // text IDs (tools/gentext.py)
#include "gen/CastDefs.event"        // BS_PID_* / BS_LV_* / BS_CLASS_* (tools/gencast.py)
#include "gen/FE7FaceDefs.event"     // BS_FACE_* (tools/import_fe7_faces.py)
#include "gen/MapDefs.event"         // BS_MAP_TILESET_* from maps/*.tmx (tools/buildmaps.py)

